model VendorSalesMeeting {
  id               String                    @id @default(cuid())
  vendorUserId     String
  requestedStartAt DateTime
  requestedEndAt   DateTime
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  meetingUrl       String?
  vendorNote       String?
  vendorMessage    String?
  adminNote        String?
  status           VendorSalesMeetingStatus @default(PENDING)
  reviewedByAdminId String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  vendor VendorProfile @relation(fields: [vendorUserId], references: [userId], onDelete: Cascade)

  @@index([vendorUserId, status, requestedStartAt])
  @@index([status, scheduledStartAt])
  @@index([reviewedByAdminId])
  @@map("vendor_sales_meetings")
}
