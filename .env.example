NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epic_wedplanner?schema=public"
JWT_ACCESS_SECRET="replace-with-a-unique-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-unique-random-secret-at-least-32-characters"
JWT_RESET_SECRET="replace-with-a-third-unique-random-secret-at-least-32-characters"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
SMTP_HOST="sandbox.smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
MAIL_FROM_NAME="Epic Wedplanner"
MAIL_FROM_ADDRESS="no-reply@example.com"
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# RabbitMQ (OTP email queue)
RABBITMQ_URL="amqp://localhost"
RABBITMQ_OTP_QUEUE="epic-wedplanner.otp-emails"
RABBITMQ_PREFETCH=5
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRIES=3


GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
UPLOAD_MAX_BYTES=5242880
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="ChangeThisPassword123"
SUPERADMIN_FIRST_NAME="Super"
SUPERADMIN_LAST_NAME="Admin"
SUPERADMIN_PHONE="9999999999"
