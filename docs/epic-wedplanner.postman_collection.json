        {
          "name": "Google login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/google/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{googleIdToken}}\",\n  \"role\": \"CLIENT\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Google ID token must be issued for GOOGLE_CLIENT_ID. role is needed only for a new account.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const body = pm.response.json();",
                  "  const prefix = body.data?.user?.role === 'VENDOR' ? 'vendor' : 'client';",
                  "  const save = (key, value) => {",
                  "    if (!value) return;",
                  "    if (pm.environment.name) pm.environment.set(key, value);",
                  "    else pm.collectionVariables.set(key, value);",
                  "  };",
                  "  save(prefix + 'AccessToken', body.data?.accessToken);",
                  "  save(prefix + 'RefreshToken', body.data?.refreshToken);",
                  "  if (prefix === 'vendor') save('vendorUserId', body.data?.user?.id);",
                  "}"
                ]
              }
            }
          ]
        },
