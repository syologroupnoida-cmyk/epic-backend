            "url": "{{baseUrl}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{vendorRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Can also use the httpOnly refresh cookie.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  for (const key of ['vendorAccessToken', 'vendorRefreshToken']) {",
                  "    if (pm.environment.name) pm.environment.unset(key);",
                  "    else pm.collectionVariables.unset(key);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
